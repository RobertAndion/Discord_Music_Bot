#!/usr/bin/env bash
# Runs everything that used to run in GitHub Actions CI (lint, tests with
# coverage, Trivy security scan) locally, for free. The only thing CI still does
# on a PR is build/lint; deploys happen on push to master.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! python3 -c "import flake8" 2>/dev/null || ! python3 -c "import pytest" 2>/dev/null; then
    echo "pre-push: flake8/pytest not installed — run: pip install -r requirements.txt pytest pytest-asyncio pytest-cov pytest-mock flake8" >&2
    exit 1
fi

echo "pre-push: flake8 (syntax / undefined-name check)"
python3 -m flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics

echo "pre-push: flake8 (style / complexity — advisory)"
python3 -m flake8 . --count --exit-zero --max-complexity=10 --max-line-length=100 --statistics

echo "pre-push: pytest"
mkdir -p ServerData
if python3 -c "import pytest_cov" 2>/dev/null; then
    python3 -m pytest tests/ --tb=short --cov=. --cov-report=term-missing:skip-covered
else
    python3 -m pytest tests/ --tb=short
fi

echo "pre-push: trivy (CRITICAL/HIGH vulnerabilities)"
if command -v trivy >/dev/null 2>&1; then
    trivy fs . --scanners vuln --severity CRITICAL,HIGH --exit-code 1 --quiet
else
    echo "pre-push: trivy not installed — skipping (brew install trivy)" >&2
fi

echo "pre-push: all checks passed"
